Output "terminal-frames/"
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 16
Set Width 1440
Set Height 1000
Set Padding 20
Set Framerate 15
Set TypingSpeed 60ms
Set Theme {"background":"#0e0d0b","foreground":"#f4efdf","black":"#0e0d0b","red":"#ed705f","green":"#52ce91","yellow":"#eba92c","blue":"#5db9d6","magenta":"#aa95ef","cyan":"#69cfc2","white":"#f4efdf","brightBlack":"#9e9787","brightRed":"#ed705f","brightGreen":"#52ce91","brightYellow":"#eba92c","brightBlue":"#5db9d6","brightMagenta":"#aa95ef","brightCyan":"#69cfc2","brightWhite":"#ffffff"}
Hide
Type "clear; node --require ./tools/marketing/clock.cjs ./packages/cli/dist/index.js"
Enter
Sleep 4s
Type "m"
Sleep 2s
Show
Sleep 4s
Type "w"
Sleep 3s
Type "m"
Sleep 4s
