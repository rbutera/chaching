{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "main",
	"namedInputs": {
		"globals": [
			"{workspaceRoot}/nx.json",
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/pnpm-workspace.yaml",
			"{workspaceRoot}/.npmrc",
			"{workspaceRoot}/.nvmrc",
			"{workspaceRoot}/tsconfig.base.json",
			"{workspaceRoot}/eslint.config.mjs",
			"{workspaceRoot}/tools/eslint-boundaries.mjs"
		],
		"default": [
			"{projectRoot}/**/*",
			"!{projectRoot}/node_modules/**/*",
			"!{projectRoot}/dist/**/*",
			"!{projectRoot}/build/**/*",
			"!{projectRoot}/.svelte-kit/**/*",
			"globals"
		],
		"production": [
			"default",
			"!{projectRoot}/**/*.test.*",
			"!{projectRoot}/**/*.spec.*",
			"!{projectRoot}/src/test-setup.ts"
		]
	},
	"targetDefaults": {
		"typecheck": {
			"cache": true,
			"inputs": [
				"default",
				"^production"
			]
		},
		"lint": {
			"cache": true,
			"inputs": [
				"default",
				"^production"
			]
		},
		"test": {
			"cache": true,
			"inputs": [
				"default",
				"^production",
				{
					"runtime": "node -p \"process.platform + '-' + process.arch + '-' + process.versions.node\""
				},
				{
					"runtime": "node -p \"Boolean(process.env.CHACHING_TEST_DATABASE_URL)\""
				},
				{
					"env": "CHACHING_TEST_PG_TOOLS"
				},
				{
					"env": "CHACHING_PRICING_REFRESH"
				}
			]
		},
		"build": {
			"cache": true,
			"inputs": [
				"production",
				"^production",
				{
					"env": "CHACHING_BASE_PATH"
				},
				{
					"runtime": "node -p \"process.platform + '-' + process.arch + '-' + process.versions.node\""
				}
			]
		}
	},
	"plugins": []
}
