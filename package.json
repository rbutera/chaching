{
	"name": "chaching-workspace",
	"version": "1.18.1",
	"description": "Local multi-provider AI token spend dashboard for Claude Code, Codex, OpenCode, Pi, OMP, and Cursor.",
	"private": true,
	"type": "module",
	"license": "PolyForm-Noncommercial-1.0.0",
	"author": "Rai Butera",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rbutera/chaching.git"
	},
	"homepage": "https://github.com/rbutera/chaching#readme",
	"bugs": {
		"url": "https://github.com/rbutera/chaching/issues"
	},
	"engines": {
		"node": ">=24.16.0"
	},
	"keywords": [
		"ai",
		"tokens",
		"claude-code",
		"tokenmaxx",
		"codex",
		"opencode",
		"oh-my-pi",
		"cursor",
		"dashboard"
	],
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "pnpm exec nx run web:dev",
		"build": "pnpm exec nx run-many -t build --projects=cli,web",
		"build:cli": "pnpm exec nx run cli:build",
		"build:sk": "pnpm exec nx run web:build",
		"check": "pnpm boundaries && pnpm exec nx run-many -t typecheck",
		"test": "pnpm exec nx run-many -t test",
		"package": "pnpm exec nx run distribution:package",
		"boundaries": "node tools/check-boundaries.mjs",
		"verify:package": "node tools/verify-package.mjs",
		"gen:assets": "pnpm exec nx run web:assets",
		"preview": "pnpm exec nx run web:preview",
		"start": "node dist/chaching/bin/chaching.js",
		"pack:dry": "pnpm --dir dist/chaching pack --dry-run"
	},
	"devDependencies": {
		"nx": "23.1.2",
		"@nx/eslint-plugin": "23.1.2",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"@typescript-eslint/parser": "8.68.0",
		"typescript-eslint": "8.68.0",
		"svelte-eslint-parser": "1.8.1",
		"svelte": "5.56.4",
		"typescript": "6.0.3",
		"@types/node": "24.13.2",
		"vitest": "4.1.7",
		"tsx": "4.22.4"
	},
	"nx": {
		"includedScripts": []
	}
}
